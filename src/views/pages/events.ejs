="2026-12">Dezembro de 2026</option></select></div><div class="col-sm-6"><label class="form-label" for="eventCategory">Categoria</label><select class="form-select" id="eventCategory" name="category"><option value="">Todas as categorias</option><option>Acadêmico</option><option>Avaliações</option><option>Institucional</option><option>Tecnologia</option></select></div></form><p class="results-label" id="eventStatus" role="status" aria-live="polite"><%= events.length %> atividades no semestre</p><div id="eventResults"><% events.forEach(event => { %><%- include('../partials/event-row', { event, detailed: true }) %><% }); %></div></div></div><p class="source-note mt-5">Seleção de datas do <a href="<%= calendarSource %>" target="_blank" rel="noopener noreferrer">calendário oficial de 2026, com retificações</a>. Horários e programação específica devem ser confirmados com a unidade. Consulta: 21/09/2026.</p></div></section>
