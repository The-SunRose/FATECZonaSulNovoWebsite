<article class="event-row"><div class="event-date"><strong><%= event.start.slice(8) %></strong><span><%= new Date(event.start + 'T12:00:00').toLocaleDateString('pt-BR', { month: 'short' }).replace('.', '') %></span></div><div class="event-content"><span class="category-label"><%= event.category %></span><h3><%= event.title %></h3><p><%= event.start !== event.end ? dateLabel(event.start) + ' a ' + dateLabel(event.end) : dateLabel(event.start) %> · <%= event.start.slice(0, 4) %></p><% if (typeof detailed !== 'undefined' && detailed) { %><p class="event-description"><%= event.description %></p><% } %></div><a class="event-arrow" href="<%= event.source %>" target="_blank" rel="noopener noreferrer" aria-label="Consultar <%= event.title %> no calendário oficial (PDF)"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></article>
