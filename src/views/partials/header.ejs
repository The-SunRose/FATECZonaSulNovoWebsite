<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="#a6192e">
  <meta property="og:title" content="<%= title %> | Fatec Zona Sul">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <title><%= title %> | Fatec Zona Sul</title>
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/assets/css/styles.css">
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js" defer></script>
  <script src="/assets/js/main.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Pular para o conteúdo</a>
<div class="utility-bar">
  <div class="container d-flex align-items-center justify-content-between gap-3">
    <span>Ensino superior público, gratuito e de qualidade.</span>
    <div class="d-flex align-items-center gap-4"><a href="https://www.cps.sp.gov.br/" target="_blank" rel="noopener noreferrer">Centro Paula Souza <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><a href="https://siga.cps.sp.gov.br/aluno/login.aspx" target="_blank" rel="noopener noreferrer"><i class="bi bi-person" aria-hidden="true"></i> Área do aluno</a></div>
  </div>
</div>
<header class="site-header">
<nav class="navbar navbar-expand-lg container" aria-label="Navegação principal">
  <a class="brand navbar-brand" href="/" aria-label="Fatec Zona Sul — página inicial"><span class="brand-word">Fatec<span class="brand-dot">.</span></span><span class="brand-place">Zona Sul<span>Dom Paulo Evaristo Arns</span></span></a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menu"><i class="bi bi-list" aria-hidden="true"></i></button>
  <div class="collapse navbar-collapse" id="mainNav">
    <ul class="navbar-nav ms-auto align-items-lg-center">
      <% [['/', 'Início'], ['/cursos', 'Cursos'], ['/infraestrutura', 'Infraestrutura'], ['/eventos', 'Eventos'], ['/quem-somos', 'Quem somos']].forEach(([href, label]) => { const active = href === '/' ? ['/', '/index.html'].includes(currentPath) : currentPath.startsWith(href); %>
      <li class="nav-item"><a class="nav-link <%= active ? 'active' : '' %>" href="<%= href %>" <%- active ? 'aria-current="page"' : '' %>><%= label %></a></li>
      <% }); %>
      <li class="nav-item ms-lg-3"><a class="btn btn-brand nav-cta" href="/vestibular" <%- currentPath === '/vestibular' ? 'aria-current="page"' : '' %>>Vestibular <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></li>
    </ul>
  </div>
</nav>
</header>
<main id="main">
